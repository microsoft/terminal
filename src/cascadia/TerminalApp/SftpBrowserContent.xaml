<UserControl x:Class="TerminalApp.SftpBrowserContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:TerminalApp"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mtu="using:Microsoft.Terminal.UI"
             xmlns:mux="using:Microsoft.UI.Xaml.Controls"
             AutomationProperties.LocalizedControlType="pane"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="PageBackground">#282828</Color>
                    <Color x:Key="ToolbarBackground">#202020</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="PageBackground">#F9F9F9</Color>
                    <Color x:Key="ToolbarBackground">#E8E8E8</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="PageBackground"
                                    ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="ToolbarBackground"
                                    ResourceKey="SystemColorWindowColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid AllowFocusOnInteraction="False"
          AutomationProperties.AccessibilityView="Raw"
          Background="{ThemeResource PageBackground}"
          TabFocusNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ========================= Toolbar ========================  -->
        <Grid Grid.Row="0"
              Padding="4,2"
              Background="{ThemeResource ToolbarBackground}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="connectButton"
                    Grid.Column="0"
                    Margin="2,0"
                    Padding="6,4"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="_connectClick"
                    ToolTipService.ToolTip="Connect">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="14"
                          Glyph="&#xE8A7;" />
                <!--  Link  -->
            </Button>

            <Button x:Name="disconnectButton"
                    Grid.Column="1"
                    Margin="2,0"
                    Padding="6,4"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="_disconnectClick"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Disconnect">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="14"
                          Glyph="&#xE711;" />
                <!--  DisconnectDrive  -->
            </Button>

            <ToggleButton x:Name="hiddenButton"
                          Grid.Column="2"
                          Margin="2,0"
                          Padding="6,4"
                          Background="Transparent"
                          BorderThickness="0"
                          Click="_toggleHiddenFilesClick"
                          IsChecked="False"
                          ToolTipService.ToolTip="Show hidden files">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="14"
                          Glyph="&#xE890;" />
                <!--  View (eye)  -->
            </ToggleButton>

            <Button x:Name="upButton"
                    Grid.Column="3"
                    Margin="2,0"
                    Padding="6,4"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="_upClick"
                    ToolTipService.ToolTip="Back to parent folder">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="14"
                          Glyph="&#xE74A;" />
                <!--  ChevronUp  -->
            </Button>

            <StackPanel Grid.Column="5"
                        Orientation="Horizontal">
                <Button x:Name="newFileButton"
                        Margin="2,0"
                        Padding="6,4"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="_newFileClick"
                        IsEnabled="False"
                        ToolTipService.ToolTip="New file">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="14"
                              Glyph="&#xE7C3;" />
                    <!--  Page  -->
                </Button>

                <Button x:Name="newFolderButton"
                        Margin="2,0"
                        Padding="6,4"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="_newFolderClick"
                        IsEnabled="False"
                        ToolTipService.ToolTip="New folder">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="14"
                              Glyph="&#xE8B7;" />
                    <!--  Folder  -->
                </Button>

                <Button x:Name="uploadButton"
                        Margin="2,0"
                        Padding="6,4"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="_uploadClick"
                        IsEnabled="False"
                        ToolTipService.ToolTip="Upload files">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="14"
                              Glyph="&#xE898;" />
                    <!--  Upload  -->
                </Button>

                <Button x:Name="downloadButton"
                        Margin="2,0"
                        Padding="6,4"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="_downloadClick"
                        IsEnabled="False"
                        ToolTipService.ToolTip="Download to a local folder">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="14"
                              Glyph="&#xE896;" />
                    <!--  Download  -->
                </Button>

                <Button x:Name="editCodeButton"
                        Margin="2,0"
                        Padding="6,4"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="_openInVSCodeClick"
                        IsEnabled="False"
                        ToolTipService.ToolTip="Open in VS Code">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="14"
                              Glyph="&#xE943;" />
                    <!--  Code  -->
                </Button>

                <Button x:Name="refreshButton"
                        Margin="2,0"
                        Padding="6,4"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="_refreshClick"
                        IsEnabled="False"
                        ToolTipService.ToolTip="Refresh">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="14"
                              Glyph="&#xE72C;" />
                    <!--  Refresh  -->
                </Button>

                <Button x:Name="closeButton"
                        Margin="2,0"
                        Padding="6,4"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="_closeClick"
                        ToolTipService.ToolTip="Close SFTP browser">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="14"
                              Glyph="&#xE8BB;" />
                    <!--  ChromeClose  -->
                </Button>
            </StackPanel>
        </Grid>

        <!--  ========================= Path bar ========================  -->
        <Grid Grid.Row="1"
              Padding="4,4,4,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Margin="4,0,8,0"
                       VerticalAlignment="Center"
                       Text="REMOTE"
                       Style="{ThemeResource CaptionTextBlockStyle}" />
            <TextBox x:Name="pathBox"
                     Grid.Column="1"
                     Padding="8,4"
                     AcceptsReturn="False"
                     IsEnabled="False"
                     KeyDown="_pathBoxKeyDown"
                     PlaceholderText="/"
                     AllowFocusOnInteraction="True">
                <TextBox.ContextFlyout>
                    <mtu:TextMenuFlyout />
                </TextBox.ContextFlyout>
            </TextBox>
        </Grid>

        <!--  ========================= Connection form ========================  -->
        <Grid x:Name="connectForm"
              Grid.Row="2"
              Padding="4,2,4,4"
              Background="{ThemeResource ToolbarBackground}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Margin="4,0,4,0"
                       VerticalAlignment="Center"
                       Text="Host" />
            <TextBox x:Name="hostBox"
                     Grid.Row="0"
                     Grid.Column="1"
                     Margin="0,0,4,0"
                     Padding="6,3"
                     PlaceholderText="host"
                     AllowFocusOnInteraction="True" />

            <TextBlock Grid.Row="0"
                       Grid.Column="2"
                       Margin="4,0,4,0"
                       VerticalAlignment="Center"
                       Text="Port" />
            <TextBox x:Name="portBox"
                     Grid.Row="0"
                     Grid.Column="3"
                     Margin="0,0,4,0"
                     Padding="6,3"
                     PlaceholderText="22"
                     AllowFocusOnInteraction="True" />

            <TextBlock Grid.Row="0"
                       Grid.Column="4"
                       Margin="4,0,4,0"
                       VerticalAlignment="Center"
                       Text="User" />
            <TextBox x:Name="userBox"
                     Grid.Row="0"
                     Grid.Column="5"
                     Margin="0,0,4,0"
                     Padding="6,3"
                     PlaceholderText="user"
                     AllowFocusOnInteraction="True" />

            <TextBlock Grid.Row="0"
                       Grid.Column="6"
                       Margin="4,0,4,0"
                       VerticalAlignment="Center"
                       Text="Password" />
            <PasswordBox x:Name="passBox"
                         Grid.Row="0"
                         Grid.Column="7"
                         Margin="0,0,4,0"
                         Padding="6,3"
                         AllowFocusOnInteraction="True" />

            <Button x:Name="connectActionButton"
                    Grid.Row="0"
                    Grid.Column="8"
                    Padding="14,4"
                    Click="_connectClick">
                <TextBlock Text="Connect" />
            </Button>

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Grid.ColumnSpan="9"
                       Margin="4,2,4,0"
                       VerticalAlignment="Center"
                       Text="Private key (optional, overrides password)"
                       Style="{ThemeResource CaptionTextBlockStyle}" />
            <TextBox x:Name="keyBox"
                     Grid.Row="2"
                     Grid.Column="0"
                     Grid.ColumnSpan="9"
                     Margin="4,2,4,0"
                     Padding="6,3"
                     PlaceholderText="C:\Users\you\.ssh\id_ed25519"
                     AllowFocusOnInteraction="True" />

            <TextBlock Grid.Row="3"
                       Grid.Column="0"
                       Margin="8,4,4,2"
                       VerticalAlignment="Center"
                       Text="Profiles" />
            <Grid Grid.Row="3"
                  Grid.Column="1"
                  Grid.ColumnSpan="8"
                  Margin="0,2,4,2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0"
                      Padding="6,2"
                      Background="{ThemeResource ToolbarBackground}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Text="Host"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Text="User"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <ListView x:Name="profilesListView"
                          Grid.Row="1"
                          MaxHeight="120"
                          SelectionMode="Single"
                          SelectionChanged="_profilesListSelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="2" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:SftpProfileItem">
                            <Grid Padding="6,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Text="{x:Bind Host}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Text="{x:Bind Username}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            <StackPanel Grid.Row="4"
                        Grid.Column="0"
                        Grid.ColumnSpan="9"
                        Orientation="Horizontal">
                <Button Margin="2,2"
                        Padding="10,3"
                        Click="_saveProfileClick"
                        ToolTipService.ToolTip="Save the current connection as a profile">
                    <TextBlock Text="Save" />
                </Button>
                <Button Margin="2,2"
                        Padding="10,3"
                        Click="_deleteProfileClick"
                        ToolTipService.ToolTip="Delete the selected profile">
                    <TextBlock Text="Delete" />
                </Button>
                <Button Margin="2,2"
                        Padding="10,3"
                        Click="_newProfileClick"
                        ToolTipService.ToolTip="Clear the connection form">
                    <TextBlock Text="Clear" />
                </Button>
            </StackPanel>
        </Grid>

        <!--  ========================= File list ========================  -->
        <ListView x:Name="fileList"
                  Grid.Row="3"
                  Margin="4,0,0,0"
                  AllowDrop="True"
                  AllowFocusOnInteraction="True"
                  CanDragItems="False"
                  DragOver="_fileListDragOver"
                  DoubleTapped="_fileListDoubleTapped"
                  Drop="_fileListDrop"
                  IsItemClickEnabled="False"
                  RightTapped="_fileListRightTapped"
                  SelectionMode="Extended"
                  TabFocusNavigation="Cycle">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="2" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:SftpFileEntry">
                    <Grid Height="26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0"
                                  Margin="4,0,8,0"
                                  VerticalAlignment="Center"
                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  FontSize="13"
                                  Glyph="{x:Bind Glyph}" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="{x:Bind Name}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2"
                                   Margin="4,0"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Text="{x:Bind SizeText}" />
                        <TextBlock Grid.Column="3"
                                   Margin="4,0"
                                   VerticalAlignment="Center"
                                   Text="{x:Bind ModTimeText}" />
                        <TextBlock Grid.Column="4"
                                   Margin="4,0"
                                   VerticalAlignment="Center"
                                   Text="{x:Bind Permissions}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--  ========================= Status bar ========================  -->
        <Grid Grid.Row="4"
              Padding="4,2"
              Background="{ThemeResource ToolbarBackground}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="statusText"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Text="Not connected" />
            <ProgressRing x:Name="progressRing"
                          Grid.Column="1"
                          Width="16"
                          Height="16"
                          Margin="8,0,4,0"
                          IsActive="False"
                          Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>